                            <constraint firstItem="bear" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" id="cy"/>
                            <constraint firstItem="bear" firstAttribute="width" constant="200" id="w"/>
                            <constraint firstItem="bear" firstAttribute="height" constant="200" id="h"/>
                            <constraint firstItem="title" firstAttribute="top" secondItem="bear" secondAttribute="bottom" constant="24" id="t1"/>
                            <constraint firstItem="title" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="t2"/>
                            <constraint firstItem="note" firstAttribute="top" secondItem="title" secondAttribute="bottom" constant="8" id="n1"/>
                            <constraint firstItem="note" firstAttribute="leading" secondItem="safe" secondAttribute="leading" constant="32" id="n2"/>
                            <constraint firstItem="safe" firstAttribute="trailing" secondItem="note" secondAttribute="trailing" constant="32" id="n3"/>
