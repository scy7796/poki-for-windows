Poki's patch to jkcoxson/idevice at commit 89702099f4d7552f704f93b4526756abda319ceb,
https://github.com/jkcoxson/idevice, MIT license (LICENSE.txt in that repository).
It adds run_over_rsd to idevice/src/services/dvt/xctest/mod.rs, adapted from XCUITestService::run in
the same file, so PokiLauncher can run the runner's test over an RSD tunnel it already holds.
native/launcher/fetch-idevice.sh applies it to .deps/idevice-launcher.

--- a/idevice/src/services/dvt/xctest/mod.rs
+++ b/idevice/src/services/dvt/xctest/mod.rs
@@ -2150,6 +2150,89 @@
     }
 }
 
+/// Runs an XCTest plan (for example a WebDriverAgent runner) over an RSD tunnel the caller already
+/// holds, for devices reached through the remote pairing service, where there is no lockdown
+/// provider. The steps are those of [`XCUITestService::run`] from step 3 on; the caller supplies
+/// the iOS major version and a `TestConfig` built from an installation proxy it opened itself.
+/// (poki-remote patch.)
+pub async fn run_over_rsd<L: XCUITestListener>(
+    handle: &mut crate::tcp::handle::AdapterHandle,
+    handshake: &RsdHandshake,
+    ios_major_version: u8,
+    cfg: TestConfig,
+    listener: &mut L,
+    timeout: Option<std::time::Duration>,
+) -> Result<(), IdeviceError> {
+    let session_id = uuid::Uuid::new_v4();
+    let xctest_path = format!(
+        "/tmp/{}.xctestconfiguration",
+        session_id.to_string().to_uppercase()
+    );
+    let xctest_config = cfg.build_xctest_configuration(session_id, ios_major_version)?;
+
+    let dvt = rsd_connect(
+        handle,
+        handshake,
+        "com.apple.instruments.dtservicehub",
+        "dtservicehub",
+        true,
+    )
+    .await?;
+    let ctrl = rsd_connect(handle, handshake, TESTMANAGERD_RSD_SERVICE, "testmanagerd-ctrl", false).await?;
+    let main = rsd_connect(handle, handshake, TESTMANAGERD_RSD_SERVICE, "testmanagerd-main", false).await?;
+    let mut conns = TestManagerConnections {
+        ctrl,
+        main,
+        dvt,
+        rsd_handles: Vec::new(),
+    };
+    let mut ctrl_proxy = TestManagerProxy::open(&mut conns.ctrl, ios_major_version).await?;
+    let mut main_proxy = TestManagerProxy::open(&mut conns.main, ios_major_version).await?;
+    let mut process_control = XCTestProcessControlChannel::open(&mut conns.dvt).await?;
+
+    let config_name = cfg.config_name().to_owned();
+    initialize_testmanager_sessions(&mut ctrl_proxy, &mut main_proxy, &xctest_config).await?;
+    register_early_driver_channel_handler(&mut conns.main, &xctest_config).await;
+    initialize_testmanager_daemon_sessions(
+        &mut ctrl_proxy,
+        &mut main_proxy,
+        ios_major_version,
+        &session_id,
+        &xctest_config,
+    )
+    .await?;
+    let (launch_args, launch_env, launch_options) = build_launch_env(
+        ios_major_version,
+        &session_id,
+        &cfg.runner_app_path,
+        &cfg.runner_app_container,
+        &config_name,
+        &xctest_path,
+        cfg.runner_env.as_ref(),
+        cfg.runner_args.as_deref(),
+    );
+    let _pid = launch_and_authorize_test_runner(
+        &mut ctrl_proxy,
+        &mut process_control,
+        ios_major_version,
+        &cfg.runner_bundle_id,
+        launch_args,
+        launch_env,
+        launch_options,
+    )
+    .await?;
+    let driver_channel = start_test_plan_session(&mut conns.main, &mut main_proxy).await?;
+    run_dispatch_loop_until_done_or_disconnect(
+        &mut conns.main,
+        driver_channel,
+        &xctest_config,
+        listener,
+        timeout,
+    )
+    .await?;
+    Ok(())
+}
