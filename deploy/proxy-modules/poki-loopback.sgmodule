#!name=Poki Device Loopback
#!desc=Reflects 10.7.0.1 back to this iPhone so Poki can reach the phone's own developer services (lockdown 62078, RemotePairing 49152). Needs Enhanced Mode. Surge iOS 5.23.0+.
#!system=ios

[General]
ipv6-vif = disabled
tun-included-routes = %INSERT% 10.7.0.1/32

[IP Rewrite]
10.7.0.1 = reflect
